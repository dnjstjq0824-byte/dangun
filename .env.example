# ==============================================================================
# BN NEAR — Production Environment Variables Template
# Order ID: BN-NEAR-MASTER-001 | Booking Network Co., Ltd.
# ==============================================================================

# Core Ports
PORT=8080
ADMIN_PORT=3001
WEB_PORT=3000

# Security & Tokens
JWT_SECRET=replace-with-a-cryptographically-secure-random-64-char-string-in-production
JWT_EXPIRATION_HOURS=72

# Database (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=bn_near
POSTGRES_PASSWORD=replace-with-secure-production-db-password
POSTGRES_DB=bn_near_db
DATABASE_URL=postgres://bn_near:replace-with-secure-production-db-password@localhost:5432/bn_near_db?sslmode=disable

# Cache & Messaging (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Geospatial Verification Policy
GEO_VERIFICATION_ACCURACY_THRESHOLD=150
GEO_DEFAULT_RADIUS_METERS=5000

# Object Storage (S3 Compatible / Local)
STORAGE_DRIVER=local
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-northeast-2
S3_BUCKET=bn-near-media-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Public Endpoints (For Clients)
API_BASE_URL=https://api.bnnear.com/api/v1
WS_BASE_URL=wss://api.bnnear.com/api/v1/ws
