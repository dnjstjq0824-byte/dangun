# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY services/ services/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bn-near-worker ./services/worker/cmd

# Final minimal runner
FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bn-near-worker /app/bn-near-worker

ENTRYPOINT ["/app/bn-near-worker"]
